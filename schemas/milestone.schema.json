{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cvg:workspace-protocol:schema:milestone:1.0.0",
  "title": "CVG Milestone Record",
  "description": "A lifecycle-controlled unit of progress with explicit evidence references.",
  "type": "object",
  "required": ["schema_version", "milestone_id", "case_id", "title", "description", "status", "evidence_refs", "metadata", "created_at", "updated_at", "created_by", "updated_by"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "milestone_id": { "$ref": "#/$defs/identifier" },
    "case_id": { "$ref": "#/$defs/identifier" },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "description": { "type": "string", "maxLength": 8000 },
    "status": { "enum": ["proposed", "pending", "in_progress", "blocked", "validated", "rejected", "completed", "cancelled"] },
    "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidence_ref" } },
    "metadata": { "$ref": "#/$defs/json_object" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "created_by": { "$ref": "#/$defs/provenance" },
    "updated_by": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [{
    "if": {
      "properties": { "status": { "enum": ["validated", "completed"] } },
      "required": ["status"]
    },
    "then": {
      "properties": { "evidence_refs": { "type": "array", "minItems": 1 } }
    }
  }],
  "additionalProperties": false,
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,199}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "json_object": { "type": "object" },
    "provenance": {
      "type": "object",
      "required": ["actor", "actor_type", "source", "occurred_at"],
      "properties": {
        "actor": { "$ref": "#/$defs/identifier" },
        "actor_type": { "enum": ["human", "agent", "system", "tool", "import"] },
        "source": { "type": "string", "minLength": 1, "maxLength": 500 },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "run_id": { "$ref": "#/$defs/identifier" },
        "tool": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "evidence_ref": {
      "type": "object",
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "uri": { "type": "string", "format": "uri" },
        "path": { "$ref": "#/$defs/relative_path" },
        "locator": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "note": { "type": "string", "maxLength": 4000 }
      },
      "anyOf": [
        { "properties": { "artifact_id": true }, "required": ["artifact_id"] },
        { "properties": { "uri": true }, "required": ["uri"] },
        { "properties": { "path": true }, "required": ["path"] },
        { "properties": { "locator": true }, "required": ["locator"] },
        { "properties": { "digest": true }, "required": ["digest"] }
      ],
      "additionalProperties": false
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(?![A-Za-z]:)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^/\\\\<>:\"|?*\\u0000-\\u001F]+(?:/[^/\\\\<>:\"|?*\\u0000-\\u001F]+)*$"
    }
  },
  "examples": [{
    "schema_version": "1.0.0",
    "milestone_id": "milestone-case-0042-hypothesis-1",
    "case_id": "case-2026-0042",
    "title": "Validate pool-contention hypothesis",
    "description": "Run a controlled QA load and compare checkout timing.",
    "status": "validated",
    "evidence_refs": [{ "artifact_id": "artifact-case-0042-test-run-1", "note": "Controlled QA run" }],
    "metadata": {},
    "created_at": "2026-08-06T14:00:00Z",
    "updated_at": "2026-08-06T15:12:10Z",
    "created_by": { "actor": "agent-planner", "actor_type": "agent", "source": "case-planning", "occurred_at": "2026-08-06T14:00:00Z" },
    "updated_by": { "actor": "agent-validator", "actor_type": "agent", "source": "test-execution", "occurred_at": "2026-08-06T15:12:10Z" }
  }]
}
